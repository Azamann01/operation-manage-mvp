# Copy to .env and fill in for your environment. Never commit the real .env.

# Postgres connection string.
DATABASE_URL="postgresql://user@localhost:5432/oper_manag?schema=public"

# NextAuth session signing secret. Generate a fresh one per environment with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Canonical origin of the deployed app (no trailing slash). Used to resolve
# absolute URLs for social-preview images (app/opengraph-image.tsx) and other
# metadata. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Demo mode — controls TWO things at once:
#   1. Whether the one-click "Continue as Admin/Employee" login buttons
#      appear, and whether their credentials are sent to the browser at all
#      (see lib/demo.ts). The auth layer also independently refuses sign-in
#      for those specific seeded accounts whenever this is off, so even a
#      direct API call with the known demo password fails.
#   2. Whether `npm run db:seed` is allowed to run — that script deletes all
#      existing data before reseeding.
#
# Leave unset (or "false") for production once real customer data exists.
# Only set to "true" for local development or a disposable demo/staging
# database that has no real customer data in it.
DEMO_MODE="false"
